--  BUTTON CONNECTIONS
-- ══════════════════════════════════════════

spawnBtn.MouseButton1Click:Connect(function()
	local name = usernameBox.Text:match("^%s*(.-)%s*$")
	if name == "" then
		setStatus("⚠ Enter a username first.", false)
		return
	end
	setStatus("⏳ Loading " .. name .. "…", true)
	task.spawn(spawnFakeCharacter, name)
end)

removeBtn.MouseButton1Click:Connect(function()
	if spawnedModel then
		clearSpawn()
		setStatus("🗑 Model removed.", true)
	else
		setStatus("⚠ No model to remove.", false)
	end
end)

sendChatBtn.MouseButton1Click:Connect(function()
	local msg = chatBox.Text:match("^%s*(.-)%s*$")
	sendFakeChat(msg)
end)

chatBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		local msg = chatBox.Text:match("^%s*(.-)%s*$")
		sendFakeChat(msg)
	end
end)

localPlayer.CharacterRemoving:Connect(clearSpawn)

