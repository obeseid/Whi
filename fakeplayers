-- ══════════════════════════════════════════
--  BUBBLE CHAT via TextChatService
-- ══════════════════════════════════════════

-- TextChatService.BubbleChatConfiguration lets us call
-- DisplayBubble(adornee: BasePart, message: string) on the client.
-- This renders a real Roblox bubble above any part we give it.

local bubbleChat = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration")
	or TextChatService:WaitForChild("BubbleChatConfiguration", 5)

local function displayBubble(headPart, message)
	-- Primary: use the official BubbleChatMessageProperties API
	-- TextChatService.DisplayBubble is the supported client method in newer engine
	local ok = pcall(function()
		TextChatService:DisplayBubble(headPart, message)
	end)
	if ok then return end

	-- Fallback: call it on BubbleChatConfiguration directly (older API path)
	if bubbleChat then
		local ok2 = pcall(function()
			bubbleChat:DisplayBubble(headPart, message)
		end)
		if ok2 then return end
	end

	-- Last resort fallback: manual styled bubble mimicking Roblox's look
	-- (plain white rounded box, same font/size Roblox uses)
	local existing = headPart:FindFirstChild("FallbackBubble")
	if existing then existing:Destroy() end

	local bb = Instance.new("BillboardGui")
	bb.Name = "FallbackBubble"
	bb.Size = UDim2.new(0, 200, 0, 0)   -- height driven by AutomaticSize
	bb.StudsOffsetWorldSpace = Vector3.new(0, 3.5, 0)
	bb.AlwaysOnTop = false
	bb.Adornee = headPart
	bb.Parent = headPart

	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.AutomaticSize = Enum.AutomaticSize.Y
	bg.BackgroundColor3 = Color3.fromRGB(250, 250, 250)
	bg.BorderSizePixel = 0
	bg.Parent = bb

	local bgc = Instance.new("UICorner"); bgc.CornerRadius = UDim.new(0, 12); bgc.Parent = bg
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft  = UDim.new(0, 10); pad.PaddingRight  = UDim.new(0, 10)
	pad.PaddingTop   = UDim.new(0, 6);  pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = bg

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 0)
	lbl.AutomaticSize = Enum.AutomaticSize.Y
	lbl.BackgroundTransparency = 1
	lbl.Text = message
	lbl.TextColor3 = Color3.fromRGB(30, 30, 30)
	lbl.TextSize = 14
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = bg

	-- auto-destroy after 8s
	task.delay(8, function()
		if bb and bb.Parent then bb:Destroy() end
	end)
end

-- ══════════════════════════════════════════
--  CHARACTER SPAWNING LOGIC
-- ══════════════════════════════════════════

local function getMyRoot()
	local char = localPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function clearSpawn()
	if spawnedModel then
		spawnedModel:Destroy()
		spawnedModel = nil
		spawnedUsername = ""
	end
end

local function spawnFakeCharacter(username)
	clearSpawn()

	local userId
	local ok, err = pcall(function()
		userId = Players:GetUserIdFromNameAsync(username)
	end)
	if not ok or not userId then
		setStatus("❌ User not found: " .. username, false)
		return
	end

	local desc
	ok, err = pcall(function()
		desc = Players:GetHumanoidDescriptionFromUserId(userId)
	end)
	if not ok or not desc then
		setStatus("❌ Could not load appearance.", false)
		return
	end

	local model
	ok, err = pcall(function()
		model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		ok, err = pcall(function()
			model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
		end)
	end
	if not ok or not model then
		setStatus("❌ Failed to build model.", false)
		return
	end

	model.Name = username .. "_FAKE"

	local root = getMyRoot()
	local spawnCF = root
		and (root.CFrame * CFrame.new(3, 0, 0))
		or  CFrame.new(0, 5, 0)

	model.Parent = workspace
	model:SetPrimaryPartCFrame(spawnCF)

	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.DisplayName = username
	end

	-- Name tag above head
	local head = model:FindFirstChild("Head")
	if head then
		local nameBb = Instance.new("BillboardGui")
		nameBb.Name = "NameTag"
		nameBb.Size = UDim2.new(0, 180, 0, 28)
		nameBb.StudsOffset = Vector3.new(0, 2, 0)
		nameBb.Adornee = head
		nameBb.AlwaysOnTop = false
		nameBb.Parent = head

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Size = UDim2.new(1, 0, 1, 0)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = username
		nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLbl.TextSize = 14
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextStrokeTransparency = 0.4
		nameLbl.Parent = nameBb
	end

	spawnedModel   = model
	spawnedUsername = username
	setStatus("✅ Spawned: " .. username, true)
end

-- ══════════════════════════════════════════
--  FAKE CHAT LOGIC
-- ══════════════════════════════════════════

local function sendFakeChat(msg)
	if not spawnedModel then
		setStatus("⚠ Spawn a character first!", false)
		return
	end
	if msg == "" then
		setStatus("⚠ Message is empty.", false)
		return
	end

	local head = spawnedModel:FindFirstChild("Head")
	if not head then
		setStatus("⚠ Model has no Head part.", false)
		return
	end

	displayBubble(head, msg)
	setStatus("💬 Bubble sent!", true)
end

