-- ── SIMULATION STATE ─────────────────────────────────────────────────────────

local SimState = {
	active          = false,
	otherAccepted   = false,
	otherAddedSlots = {},
}

local endTrade  -- forward declaration

local function handleTradeAction(action, args)
	if not SimState.active then return end

	if action == "Add" then
		local slotId, qty = args[1], args[2]
		local itemData = _originalGetLocal({"inventory", slotId})
		if itemData then
			TradeHandler.Server.ItemAdded(
				LocalPlayer,
				slotId,
				{ id = itemData.id or slotId, name = itemData.name, amt = qty or itemData.amt, value = itemData.value }
			)
		end

	elseif action == "Remove" then
		TradeHandler.Server.ItemRemoved(args[1], LocalPlayer)

	elseif action == "Accept" then
		TradeHandler.Server.Accepted(
			LocalPlayer,
			true,
			SimState.otherAccepted and (os.time() + Constants.TRADE_FINAL_EXECUTION_DELAY) or nil
		)
		if SimState.otherAccepted then
			task.delay(Constants.TRADE_FINAL_EXECUTION_DELAY, function()
				if SimState.active then
					endTrade(false, "✅ Trade executed successfully! (simulated)")
				end
			end)
		end

	elseif action == "Cancel" then
		endTrade(false, "🚫 You declined / cancelled the trade.")

	elseif action == "Report" then
		-- silently no-op in test mode
	end
end

