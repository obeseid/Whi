-- ── PLAYER LIST ──────────────────────────────────────────────────────────────
-- Clones PlayerButtonTemplate for every player on the server (except local).
-- Clicking a button sets that player as the selected trade target.
-- Rebuilds whenever someone joins or leaves.

-- Track which player is currently selected
local selectedDisplayName = nil

local function setSelected(displayName)
	selectedDisplayName = displayName
	lblSelected.Text    = displayName or "(none)"
end

local function rebuildPlayerList()
	-- Remove all existing cloned buttons (leave template and UIListLayout)
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") and child.Name ~= "PlayerButtonTemplate" then
			child:Destroy()
		end
	end

	local order = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local btn = template:Clone()
			btn.Text        = player.DisplayName
			btn.Name        = "PlayerBtn_" .. player.UserId
			btn.LayoutOrder = order
			btn.Visible     = true
			btn.Parent      = playerList

			btn.MouseButton1Click:Connect(function()
				setSelected(player.DisplayName)
				-- Highlight selected button, dim others
				for _, sib in ipairs(playerList:GetChildren()) do
					if sib:IsA("TextButton") and sib.Name ~= "PlayerButtonTemplate" then
						sib.BackgroundTransparency = sib == btn and 0.3 or 0.71
					end
				end
			end)

			order += 1
		end
	end

	-- Auto-canvas sizing: each button is 32px tall, no padding between them
	playerList.CanvasSize = UDim2.new(0, 0, 0, order * 32)

	-- If the selected player left, clear the selection
	if selectedDisplayName then
		local stillHere = false
		for _, player in ipairs(Players:GetPlayers()) do
			if player.DisplayName == selectedDisplayName then
				stillHere = true
				break
			end
		end
		if not stillHere then
			setSelected(nil)
			AlertHandler.Add("Selected player left the server.", "Negative")
		end
	end
end

-- Initial population
rebuildPlayerList()

-- Keep the list live
Players.PlayerAdded:Connect(rebuildPlayerList)
Players.PlayerRemoving:Connect(rebuildPlayerList)

-- RefreshButton forces an immediate rebuild
btnRefresh.MouseButton1Click:Connect(rebuildPlayerList)

