-- ── TRADE LIFECYCLE ──────────────────────────────────────────────────────────

local function cleanupStubs()
	removeNetworkStub()
	removeDataStub()
	removeUtilitiesStubs()
end

endTrade = function(_, alertMsg)
	if not SimState.active then return end
	SimState.active          = false
	SimState.otherAccepted   = false
	SimState.otherAddedSlots = {}
	cleanupStubs()
	simGui.Enabled     = false
	launcherSG.Enabled = true
	LocalPlayer:SetAttribute("inTrade", false)
	fakePlayer._attrs.inTrade = false
	TradeHandler.Server.End(alertMsg)
end

local function startTrade()
	if SimState.active then
		AlertHandler.Add("A test trade is already running!", "Negative")
		return
	end

	if not selectedDisplayName then
		AlertHandler.Add("Select a player from the list first.", "Negative")
		return
	end

	fakePlayer.DisplayName      = selectedDisplayName
	fakePlayer.Name             = selectedDisplayName
	fakePlayer._attrs.inTrade   = false
	fakePlayer._attrs.inCobreed = false

	patchFlags()
	patchIsland()

	local ok, reason = TradeHandler.CanTrade(fakePlayer)
	if not ok then
		AlertHandler.Add(reason or "Cannot trade right now.", "Negative")
		return
	end

	installNetworkStub()
	installDataStub()
	installUtilitiesStubs()

	SimState.active          = true
	SimState.otherAccepted   = false
	SimState.otherAddedSlots = {}
	pendingActions           = {}

	LocalPlayer:SetAttribute("inTrade", true)
	fakePlayer:SetAttribute("inTrade", true)
	launcherSG.Enabled = false

	-- Wrap Server.End so cleanup always fires regardless of how the trade closes
	local _origEnd = TradeHandler.Server.End
	local function wrappedEnd(reason)
		LocalPlayer:SetAttribute("inTrade", false)
		fakePlayer._attrs.inTrade = false
		SimState.active    = false
		simGui.Enabled     = false
		launcherSG.Enabled = true
		cleanupStubs()
		TradeHandler.Server.End = _origEnd
		_origEnd(reason)
	end
	TradeHandler.Server.End = wrappedEnd

	TradeHandler.Server.Begin(fakePlayer)
	simGui.Enabled = true
end

-- ── PENDING ACTION LOOP ──────────────────────────────────────────────────────

task.spawn(function()
	while true do
		task.wait()
		while #pendingActions > 0 do
			local entry = table.remove(pendingActions, 1)
			local ok, err = pcall(handleTradeAction, entry.action, entry.args)
			if not ok then
				warn("[TradeTestTool] handleTradeAction error:", err)
			end
		end
	end
end)

-- ── SIM PANEL LOGIC ──────────────────────────────────────────────────────────

local function getNextOtherSlot()
	local inv = _originalGetLocal(Data, {"inventory"}) or {}
	local keys = {}
	for k in pairs(inv) do
		if not SimState.otherAddedSlots[k] then
			table.insert(keys, k)
		end
	end
	table.sort(keys)
	return keys[1]
end

simBtnAdd.MouseButton1Click:Connect(function()
	if not SimState.active then return end
	local count = 0
	for _ in pairs(SimState.otherAddedSlots) do count += 1 end
	if count >= Constants.MAX_ITEMS_PER_TRADE then
		AlertHandler.Add("[SIM] Other player is at the item cap.", "Negative"); return
	end
	local slotKey = getNextOtherSlot()
	if not slotKey then
		AlertHandler.Add("[SIM] No inventory slots available to simulate.", "Negative"); return
	end
	local itemData = _originalGetLocal(Data, {"inventory", slotKey})
	if not itemData then return end
	SimState.otherAddedSlots[slotKey] = true
	TradeHandler.Server.ItemAdded(
		{ id = itemData.id or slotKey, name = itemData.name, amt = itemData.amt, value = itemData.value },
		slotKey,
		fakePlayer
	)
end)

simBtnRemove.MouseButton1Click:Connect(function()
	if not SimState.active then return end
	local lastKey = nil
	for k in pairs(SimState.otherAddedSlots) do lastKey = k end
	if not lastKey then
		AlertHandler.Add("[SIM] Other side has no items to remove.", "Negative"); return
	end
	SimState.otherAddedSlots[lastKey] = nil
	TradeHandler.Server.ItemRemoved(lastKey, fakePlayer)
end)

simBtnAccept.MouseButton1Click:Connect(function()
	if not SimState.active then return end
	SimState.otherAccepted = not SimState.otherAccepted
	simBtnAccept.Text = SimState.otherAccepted and "↩ Unaccept (other)" or "✓ Accept (other)"
	simBtnAccept.BackgroundColor3 = SimState.otherAccepted
		and Color3.fromRGB(60,20,20) or Color3.fromRGB(25,70,35)

	local executeAt = nil
	if SimState.otherAccepted then
		local tradeObj = TradeHandler.currentObject
		if tradeObj and tradeObj.accepted and tradeObj.accepted[LocalPlayer] then
			executeAt = os.time() + Constants.TRADE_FINAL_EXECUTION_DELAY
			task.delay(Constants.TRADE_FINAL_EXECUTION_DELAY, function()
				if SimState.active then
					endTrade(false, "✅ Trade executed successfully! (simulated)")
				end
			end)
		end
	end
	TradeHandler.Server.Accepted(fakePlayer, SimState.otherAccepted, executeAt)
end)

simBtnDecline.MouseButton1Click:Connect(function()
	if not SimState.active then return end
	endTrade(true, fakePlayer.DisplayName .. " declined the trade.")
end)

