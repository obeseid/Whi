-- ── NETWORK STUB ─────────────────────────────────────────────────────────────

local _originalFireServer = Utilities.Network.FireServer
local pendingActions      = {}

local function stubFireServer(self, event, subEvent, ...)
	if event ~= "Trade" then
		return _originalFireServer(self, event, subEvent, ...)
	end
	table.insert(pendingActions, { action = subEvent, args = { ... } })
end

local function installNetworkStub()   Utilities.Network.FireServer = stubFireServer      end
local function removeNetworkStub()    Utilities.Network.FireServer = _originalFireServer  end

-- ── DATA STUB ────────────────────────────────────────────────────────────────
-- Only overrides settings.Trading and tradeBanned.
-- Real inventory flows through untouched.

local _originalGetLocal = Data.GetLocal

local function stubGetLocal(_, path)
	local p = type(path) == "table" and path or { path }
	if #p == 2 and p[1] == "settings" and p[2] == "Trading" then return true  end
	if #p == 1 and p[1] == "tradeBanned"                     then return false end
	return _originalGetLocal(Data, path)
end

local function installDataStub()
	Data.GetLocal = function(path) return stubGetLocal(Data, path) end
end
local function removeDataStub()
	Data.GetLocal = _originalGetLocal
end

-- ── UTILITIES STUBS ──────────────────────────────────────────────────────────

local _originalCanTradeItem    = Utilities.CanTradeItem
local _originalGetItemValue    = Utilities.GetItemValue
local _originalIsItemStackable = Utilities.IsItemStackable

local function installUtilitiesStubs()
	Utilities.CanTradeItem = function(itemData)
		if not itemData then return false, "Item not found" end
		if itemData.untradeable then return false, "This item cannot be traded" end
		return true
	end
	if not _originalGetItemValue then
		Utilities.GetItemValue = function(itemData, amt)
			return (itemData and itemData.value or 0) * (amt or 1)
		end
	end
	if not _originalIsItemStackable then
		Utilities.IsItemStackable = function(itemId)
			local inv = _originalGetLocal(Data, {"inventory", itemId})
			return inv and (inv.amt or 1) > 1
		end
	end
end

local function removeUtilitiesStubs()
	Utilities.CanTradeItem    = _originalCanTradeItem
	Utilities.GetItemValue    = _originalGetItemValue
	Utilities.IsItemStackable = _originalIsItemStackable
end

-- ── FLAGS / ISLAND PATCHES ───────────────────────────────────────────────────

