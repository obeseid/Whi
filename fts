-- ── PLAYER LIST ──────────────────────────────────────────────────────────────
-- Clones PlayerButtonTemplate for every player on the server (except local).
-- Clicking a button selects that player as the trade target.
-- Rebuilds whenever someone joins or leaves.
-- Selection persists even if the selected player leaves.

local selectedDisplayName = nil  -- persists across list rebuilds

local function setSelected(displayName)
	selectedDisplayName = displayName
	lblSelected.Text    = displayName or "(none)"
end

local function rebuildPlayerList()
	-- Remove all existing cloned buttons (leave template and UIListLayout intact)
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") and child.Name ~= "PlayerButtonTemplate" then
			child:Destroy()
		end
	end

	local order = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local btn = template:Clone()
			btn.Text        = player.DisplayName
			btn.Name        = "PlayerBtn_" .. player.UserId
			btn.LayoutOrder = order
			btn.Visible     = true
			-- Re-highlight if this player was already selected
			btn.BackgroundTransparency = (player.DisplayName == selectedDisplayName) and 0.3 or 0.71
			btn.Parent      = playerList

			btn.MouseButton1Click:Connect(function()
				setSelected(player.DisplayName)
				-- Highlight selected button, dim all others
				for _, sib in ipairs(playerList:GetChildren()) do
					if sib:IsA("TextButton") and sib.Name ~= "PlayerButtonTemplate" then
						sib.BackgroundTransparency = sib == btn and 0.3 or 0.71
					end
				end
			end)

			order += 1
		end
	end

	-- Auto-canvas sizing: each button is 32px tall
	playerList.CanvasSize = UDim2.new(0, 0, 0, order * 32)
	-- Note: selection is intentionally NOT cleared when the selected player leaves
end

-- Initial population
rebuildPlayerList()

-- Keep the list live on join/leave — no manual refresh needed
Players.PlayerAdded:Connect(rebuildPlayerList)
Players.PlayerRemoving:Connect(rebuildPlayerList)

