-- ── MOCK INVENTORY ───────────────────────────────────────────────────────────
-- These items are injected into your inventory during a test trade,
-- supplementing your real items. They show up in the inventory picker
-- and can be added to the trade just like real items.
--
-- Each entry:
--   amount  = how many copies of this item to inject (each gets its own slot)
--   item    = the item data table (same shape as a real inventory item)
--
-- Fields reference (horse example):
--   id          numeric breed/item type ID
--   name        custom horse name (string, or nil for none)
--   pId         personality ID (number)
--   gId         gender ID (1 = male, 2 = female typically)
--   height      float 0-1
--   food        favourite food string
--   strength/agility/speed/stamina/jump         base stats (0-1 floats)
--   strengthMod/agilityMod/speedMod/staminaMod/jumpMod  stat modifiers (0-1)
--   madeAt      creation timestamp (os.time() for "just made")
--   lineage     dictionary of { [breedId] = count } — can leave as {}
--   variants    coat/mane/tail colour and style strings

local MOCK_INVENTORY = {
	{
		amount = 4,
		item = {
			id          = 370,
			name        = "Quarter Horse",
			pId         = 1,
			gId         = 2,
			height      = 0.5,
			food        = "Golden Carrot",
			strength    = 0.5, agility  = 0.5, speed    = 0.5,
			stamina     = 0.5, jump     = 0.5,
			strengthMod = 1.0, agilityMod = 1.0, speedMod = 1.0,
			staminaMod  = 1.0, jumpMod  = 1.0,
			madeAt      = os.time(),
			lineage     = {},
			variants    = {
				colour     = "mummy",
				maneColour = "neonPurple",
				tailColour = "neonPurple",
				maneStyle  = "longQH2",
				tailStyle  = "mediumQH2",
			},
		},
	},
}

-- Builds a flat slot map from MOCK_INVENTORY, generating a unique fake UUID
-- for each copy so they appear as separate slots in the inventory.
local function buildMockSlots()
	local slots = {}
	local counter = 0
	for _, entry in ipairs(MOCK_INVENTORY) do
		local copies = entry.amount or 1
		for _ = 1, copies do
			counter += 1
			-- Fake UUID that won't collide with real slot keys
			local fakeSlotId = ("mock-%04d-0000-0000-000000000000"):format(counter)
			-- Deep-copy the item so each slot is independent
			local itemCopy = {}
			for k, v in pairs(entry.item) do
				if type(v) == "table" then
					local t = {}
					for k2, v2 in pairs(v) do t[k2] = v2 end
					itemCopy[k] = t
				else
					itemCopy[k] = v
				end
			end
			slots[fakeSlotId] = itemCopy
		end
	end
	return slots
end

