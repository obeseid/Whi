local uiElement = script.Parent

-- 1. Make it invisible immediately when the game starts
uiElement.Visible = false

-- 2. Watch the 'Visible' property. If it changes, force it back to false.
uiElement:GetPropertyChangedSignal("Visible"):Connect(function()
	if uiElement.Visible == true then
		uiElement.Visible = false
	end
end)
